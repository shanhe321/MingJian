# =====================
# Environment files
# =====================
.env
.env.*
!.env.example
backend/.env
backend/.env.*
!backend/.env.example
frontend/.env
frontend/.env.*
!frontend/.env.example
!frontend/.env.development

# =====================
# Python backend
# =====================
__pycache__/
*.py[cod]
*$py.class

.venv/
venv/
env/
backend/.venv/

.pytest_cache/
backend/.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/
backend/test.db
backend/*.db

build/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/

# Backend logs: keep the directory placeholder only.
backend/logs/*
!backend/logs/.gitkeep
*.log

# Machine learning datasets, training outputs, and model artifacts.
backend/datasets/
backend/runs/
backend/models/
backend/*.pt
backend/*.pth
backend/*.ckpt
backend/*.onnx
backend/*.engine
backend/*.torchscript

