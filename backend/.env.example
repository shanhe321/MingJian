# ═══════════════════════════════════════════════════════
# 基于 YOLOv11 的目标检测智能体平台 — 环境变量配置
# ═══════════════════════════════════════════════════════

# ── 应用基础配置 ──────────────────────────────────────
APP_NAME=RSOD Agent Platform    # FastAPI 应用名称，会用于应用信息和日志展示
APP_VERSION=0.1.0               # 应用版本号
DEBUG=true                      # 本地调试默认启用；公网部署时改为 false
PUBLIC_BASE_URL=http://127.0.0.1:8000    # 报告和 Agent 回答中的图片基址；公网部署时改为 https://实际域名
TRUSTED_HOSTS=*                          # 接受任意 Host，便于本地调试及远程图源访问
TRUST_PROXY_HEADERS=false                # 本地调试保持 false；位于可信反向代理后时改为 true

# ── PostgreSQL 数据库配置 ─────────────────────────────
# DATABASE_URL 当前由 settings.py 根据上述五项自动生成，
# 不要在 .env 中额外添加 DATABASE_URL
DB_HOST=localhost       # 手动安装 PostgreSQL 时通常使用 localhost
DB_PORT=5432            # PostgreSQL 端口
DB_NAME=rsod_agent      # 数据库名称
DB_USER=rsod_admin      # 数据库用户名
DB_PASSWORD=your-database-password  # 数据库密码，生产环境必须更换为强密码

# ── Redis 配置 ────────────────────────────────────────
# REDIS_URL 当前由 settings.py 根据下列配置自动生成，
# 不要在 .env 中额外添加 REDIS_URL
REDIS_HOST=localhost    # 手动安装 Redis 时通常使用 localhost
REDIS_PORT=6379         # Redis 端口
REDIS_PASSWORD=your-redis-password
REDIS_DB=0

# ── MinIO 对象存储配置 ────────────────────────────────
MINIO_ENDPOINT=localhost:9000            # 仅供后端访问，不会直接返回给浏览器
MINIO_ACCESS_KEY=your-minio-access-key  # MinIO Access Key
MINIO_SECRET_KEY=your-minio-secret-key  # MinIO Secret Key
MINIO_BUCKET=rsod-agent-images          # 保存检测图片、模型和其他对象的 Bucket 名称
MINIO_SECURE=false                      # 是否使用 HTTPS 连接 MinIO
STORAGE_URL_EXPIRE_SECONDS=604800       # 同源对象代理签名有效期，默认 7 天

# ── 上传和临时文件安全 ────────────────────────────────
MAX_IMAGE_SIZE_MB=20
MAX_VIDEO_SIZE_MB=200
MAX_ZIP_FILES=500
MAX_ZIP_UNCOMPRESSED_MB=1024
TEMP_MAX_AGE_HOURS=24
CAMERA_DEFECT_KEYFRAME_LIMIT=20

# ── JWT 认证配置 ──────────────────────────────────────
# 生产环境必须替换JWT 签名密钥为足够长的随机字符串
JWT_SECRET_KEY=your-super-secret-key-change-in-production   # JWT 签名密钥
JWT_ALGORITHM=HS256                 # JWT 签名算法
ACCESS_TOKEN_EXPIRE_MINUTES=30      # 登录访问令牌有效时间，单位为分钟

# ── 首次部署管理员（可选）────────────────────────────
# 仅在系统完全没有管理员时创建；创建成功后建议从环境变量中移除密码。
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-password


# ── CORS 跨域配置 ─────────────────────────────────────
# 多个前端来源使用英文逗号分隔，不要添加多余引号
# 本地前端开发地址；公网部署时改为实际前端 HTTPS Origin。
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173


# ── 日志配置 ──────────────────────────────────────────
LOG_LEVEL=INFO          # 日志级别：DEBUG / INFO / WARNING / ERROR / CRITICAL
LOG_DIR=logs            # 日志目录，相对于 backend/
LOG_MAX_BYTES=10485760  # 单个日志文件最大字节数，默认 10 MiB
LOG_BACKUP_COUNT=5      # 保留的历史日志文件数量


# ── 模型训练与数据集配置 ──────────────────────────────
TRAIN_OUTPUT_DIR=runs/train     # YOLO 训练输出目录，相对于 backend/
DATASET_BASE_DIR=datasets       # 数据集根目录，相对于 backend/


# ── OpenAI / OpenAI 兼容服务配置 ──────────────────────
# 当 QWEN_API_KEY 未配置有效值时，聊天模型和 Embedding 会使用本组配置
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_MODEL=gpt-4o-mini                # 聊天模型名称
OPENAI_BASE_URL=https://api.openai.com/v1   # OpenAI 或兼容服务的 API Base URL，通常以 /v1 结尾


# ── 通义千问配置 ──────────────────────────────────────
# 配置有效 QWEN_API_KEY 后，系统优先使用本组配置
QWEN_API_KEY=sk-your-qwen-api-key
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1     # OpenAI 兼容模式地址
QWEN_MODEL=qwen-plus    # 聊天模型名称

# ── RAG / Embedding 配置 ──────────────────────────────
# 通义千问 text-embedding-v3 对应 1024 维；
# OpenAI text-embedding-3-small 通常对应 1536 维。
# 向量维度必须与 EMBEDDING_MODEL 的实际输出维度一致
# 修改维度后需要删除并重建 knowledge_embeddings 表。
EMBEDDING_MODEL=text-embedding-v3   # Embedding 模型名称
EMBEDDING_DIM=1024      # 向量维度
RAG_CHUNK_SIZE=500      # 单个知识文本块的最大字符数
RAG_CHUNK_OVERLAP=50    # 相邻知识文本块的重叠字符数，必须小于 RAG_CHUNK_SIZE
RAG_TOP_K=3             # 每次语义检索返回的最相关知识片段数量


# ── 本地 Ollama 配置（可选）───────────────────────────
# 是否启用本地 LLM 配置。当前 Agent 创建逻辑尚未自动切换到 Ollama，
# 该配置作为本地模型接入预留项保留
USE_LOCAL_LLM=false
OLLAMA_BASE_URL=http://localhost:11434  # Ollama 服务地址
OLLAMA_MODEL=qwen2.5:7b                 # Ollama 模型名称
