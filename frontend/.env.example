# ═══════════════════════════════════════════════════════
# 前端环境变量配置
# ═══════════════════════════════════════════════════════

# 仅用于本地 Vite 开发代理。生产构建始终通过同源 /api 访问后端，
# 浏览器不会直接接触 PostgreSQL、Redis 或 MinIO 地址。
VITE_DEV_PROXY_TARGET=http://localhost:8000

# 应用名称
VITE_APP_TITLE=RSOD Agent Platform

# 开发态假登录（仅 DEV 生效）：无需后端即可进入内页/管理页调 UI
# true = 自动注入管理员会话；登录表单任意账号密码可用；401 不踢登录
# 正式联调后端时请设为 false
VITE_AUTH_MOCK=false
